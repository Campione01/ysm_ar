+// Modified copy of a YesSteveModel-Native source file (Apache-2.0), upstream commit e9ac1624.
+// Change: the GNU inline-assembly barrier in SinCosApproxFmaAvx512 is compiled only by Clang and GCC (cl error C2059).
 #pragma once
 
 #include <cglm/euler.h>
@@ -199,7 +201,9 @@ YSM_INLINE SinCos SinCosApproxFmaAvx512(__m128 input) noexcept {
         _mm256_castsi128_si256(indices), cos_indices, 1);
     __m256 table_low = _mm256_load_ps(kSinTable);
     __m256 table_high = _mm256_load_ps(kSinTable + 8);
+#if defined(__clang__) || defined(__GNUC__)
     asm volatile("" : "+x"(table_low), "+x"(table_high));
+#endif
     const __m256 table_values = _mm256_permutex2var_ps(
         table_low, table_indices, table_high);
     const __m128 sin_k = _mm256_castps256_ps128(table_values);
diff --git a/modules/gfx/src/renderer/buffer/quad_ref.h b/modules/gfx/src/renderer/buffer/quad_ref.h
index 73e0084..8c083fd 100644
--- a/modules/gfx/src/renderer/buffer/quad_ref.h
+++ b/modules/gfx/src/renderer/buffer/quad_ref.h
@@ -1,3 +1,5 @@
+// Modified copy of a YesSteveModel-Native source file (Apache-2.0), upstream commit e9ac1624.
+// Change: NdcDepthSortKey is inline instead of constexpr for MSVC without constexpr <cmath> (cl error C3615).
 #pragma once
 
 #include <bit>
@@ -9,7 +11,13 @@ namespace ysm::gfx::renderer::buffer {
 constexpr uint32_t kInvalidDepthSortKey =
     std::numeric_limits<uint32_t>::max();
 
+// MSVC 19.44 rejects a constexpr function that calls the non-constexpr
+// std::isfinite of its <cmath> (C3615); the function is only called at run time.
+#if defined(_MSC_VER) && !defined(__clang__) && !defined(__cpp_lib_constexpr_cmath)
+inline uint32_t NdcDepthSortKey(float depth) noexcept {
+#else
 constexpr uint32_t NdcDepthSortKey(float depth) noexcept {
+#endif
     if (!std::isfinite(depth)) [[unlikely]] {
         return kInvalidDepthSortKey;
     }
