+// Modified copy of a YesSteveModel-Native source file (Apache-2.0), upstream commit e9ac1624.
+// Change: EntryThunk::Invoke calls Impl through a local copy (cl 19.44 error C2102).
 #pragma once
 
 #include <cstddef>
@@ -509,8 +511,10 @@ struct EntryThunk<Impl, Desc, Fallback,
         std::conditional_t<kReturnDescriptor == "Z", jboolean, void>;
 
     static JniReturn JNICALL Invoke(JNIEnv_* env, jclass, Args... args) {
+        // MSVC 19.44: error C2102 when Impl (a plain function) is named inside the lambda.
+        const auto impl = Impl;
         const bool ok =
-            InvokeStatus<Desc>([&] { return Impl(env, args...); });
+            InvokeStatus<Desc>([&] { return impl(env, args...); });
         if constexpr (std::is_same_v<JniReturn, jboolean>) {
             return ok ? JNI_TRUE : JNI_FALSE;
         }
@@ -530,7 +534,8 @@ struct EntryThunk<Impl, Desc, Fallback,
                   "type");
 
     static R JNICALL Invoke(JNIEnv_* env, jclass, Args... args) {
-        return InvokeStatusOr<R, Desc>([&] { return Impl(env, args...); },
